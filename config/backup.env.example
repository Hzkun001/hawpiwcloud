# Local staging must be outside the public web root.
BACKUP_LOCAL_DIR=/srv/backups/hawpiwcloud
BACKUP_LOG_PATH=/var/log/hawpiwcloud/backup.log
BACKUP_STATUS_PATH=/srv/backups/hawpiwcloud/status.json
BACKUP_CATALOG_PATH=/srv/backups/hawpiwcloud/catalog.json
BACKUP_AUDIT_PATH=/srv/backups/hawpiwcloud/audit.log
BACKUP_INVENTORY_PATH=/srv/backups/hawpiwcloud/inventory.json
TRASH_DIR=/srv/hawpiwcloud-trash
TRASH_RETENTION_DAYS=30
FILE_VERSIONS_DIR=/srv/hawpiwcloud-versions

# json matches the current file-backed application. Supported: json, mysql, pgsql, sqlite.
BACKUP_DATABASE_DRIVER=json
BACKUP_DATABASE_HOST=127.0.0.1
BACKUP_DATABASE_PORT=
BACKUP_DATABASE_NAME=
BACKUP_DATABASE_USER=
BACKUP_DATABASE_PASSWORD=
BACKUP_DATABASE_PATH=

# Production should set BACKUP_REQUIRE_OFFSITE=true.
# Supported: none, local, rsync, rclone.
# rclone examples: s3:hawpiwcloud-backups, b2:hawpiwcloud-backups, minio:hawpiwcloud-backups
BACKUP_OFFSITE_DRIVER=local
BACKUP_OFFSITE_TARGET=/mnt/nas/hawpiwcloud
BACKUP_REQUIRE_OFFSITE=true

# Multi-storage overrides BACKUP_OFFSITE_DRIVER and BACKUP_OFFSITE_TARGET.
# A required target must succeed. If none are required, at least one target must
# succeed when BACKUP_REQUIRE_OFFSITE=true.
BACKUP_OFFSITE_TARGETS_JSON='[{"name":"nas","driver":"local","target":"/mnt/nas/hawpiwcloud","required":true},{"name":"s3","driver":"rclone","target":"s3:hawpiwcloud-backups","required":false}]'

# Supported compression formats: zip, tar.gz, 7z. The 7z binary is required for 7z.
BACKUP_COMPRESSION_FORMAT=zip
BACKUP_COMPRESSION_LEVEL=6

# Leave empty only for development. Production must provide a strong secret
# through a protected environment file or secret manager.
BACKUP_ENCRYPTION_PASSWORD=

BACKUP_RETENTION_DAILY_DAYS=30
BACKUP_RETENTION_WEEKLY_DAYS=90
BACKUP_RETENTION_MONTHLY_DAYS=365
BACKUP_CAPACITY_WARNING_PERCENT=85

# Optional notification channels.
BACKUP_NOTIFY_EMAIL=
BACKUP_TELEGRAM_BOT_TOKEN=
BACKUP_TELEGRAM_CHAT_ID=
BACKUP_DISCORD_WEBHOOK=
